{
  "name": "drflow-app",
  "version": "0.2.4",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "preview": "next build && next start",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint src tests scripts e2e --fix --max-warnings 0 && node scripts/fix-import-spacing.mjs",
    "lint-staged": "lint-staged",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "quality:gate": "node scripts/quality-gate.mjs",
    "quality:gate:fast": "node scripts/quality-gate.mjs --skip-build",
    "code-quality:gate": "node scripts/code-quality-gate.mjs",
    "security:gate": "node scripts/security-gate.mjs",
    "architecture:gate": "node scripts/architecture-gate.mjs",
    "stabilization:gate": "node scripts/stabilization-gate.mjs",
    "stabilization:audit": "node scripts/stabilization-audit.mjs --write",
    "architecture:review": "node scripts/architecture-review.mjs",
    "architecture:review:strict": "node scripts/architecture-review.mjs --strict",
    "performance:gate": "node scripts/performance-gate.mjs",
    "check:critical-coverage": "node scripts/check-critical-coverage.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:perf": "vitest run tests/performance",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:coverage && npm run test:perf",
    "check:coverage": "node scripts/check-coverage.mjs",
    "enterprise:status": "node scripts/enterprise-status.mjs",
    "check:supabase": "node scripts/check-supabase.mjs",
    "entitlements:dry-run:verify": "node scripts/verify-entitlement-migrations.mjs",
    "entitlements:db-push:dry-run": "node scripts/supabase-db-push-dry-run-staging.mjs",
    "entitlements:staging:history": "node scripts/entitlements-staging-selective.mjs history",
    "entitlements:staging:dry-run": "node scripts/entitlements-staging-selective.mjs dry-run",
    "entitlements:staging:apply": "node scripts/entitlements-staging-selective.mjs apply",
    "entitlements:staging:verify": "node scripts/entitlements-staging-selective.mjs verify",
    "superadmin:staging:history": "node scripts/superadmin-staging-selective.mjs history",
    "superadmin:staging:dry-run": "node scripts/superadmin-staging-selective.mjs dry-run",
    "superadmin:staging:apply": "node scripts/superadmin-staging-selective.mjs apply",
    "superadmin:staging:verify": "node scripts/superadmin-staging-selective.mjs verify",
    "supabase:preflight:staging": "node scripts/supabase-preflight-staging.mjs",
    "supabase:db-push:staging": "node scripts/supabase-db-push-staging.mjs",
    "supabase:types": "node scripts/gen-supabase-types.mjs",
    "validate:schema": "node scripts/validate-schema.mjs",
    "validate:schema:live": "node scripts/validate-schema.mjs --live",
    "check:health": "node scripts/check-health.mjs",
    "validate:env": "node scripts/validate-env.mjs",
    "validate:env:production": "node scripts/validate-env.mjs --production",
    "backup:db": "node scripts/backup-supabase.mjs",
    "docker:build": "docker build -t drflow-app .",
    "docker:run": "docker compose up --build",
    "migrate:remote": "node scripts/run-migrations.mjs",
    "migrate:pending": "node scripts/apply-pending.mjs",
    "migrate:p0": "node scripts/apply-p0-migrations.mjs",
    "migrate:production-pending": "node scripts/apply-production-pending.mjs",
    "test:rls": "vitest run tests/rls-policies.test.ts tests/cross-tenant-rls.integration.test.ts",
    "test:rls:static": "vitest run tests/rls-policies.test.ts tests/phase19-infrastructure.test.ts tests/schema-validation.test.ts",
    "deploy:vercel": "node scripts/deploy-vercel.mjs",
    "import:pami-vademecum": "node scripts/import-pami-vademecum.mjs",
    "import:pami-vademecum:apply": "node scripts/import-pami-vademecum.mjs --apply",
    "import:pami-vademecum:split": "node scripts/import-pami-vademecum.mjs --split-dir supabase/seeds/pami_batches",
    "import:national-medications": "node scripts/import-national-medications.mjs",
    "import:national-medications:download": "node scripts/import-national-medications.mjs --download",
    "import:national-medications:apply": "node scripts/import-national-medications.mjs --download --apply-api",
    "import:national-medications:split": "node scripts/import-national-medications.mjs --file data/anmat/medicamentos.json --split-dir supabase/seeds/national_batches",
    "deploy:checklist": "node scripts/print-supabase-redirects.mjs",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "lighthouse:audit": "node scripts/lighthouse-audit.mjs",
    "performance:audit": "node scripts/performance-audit.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "node scripts/fix-import-spacing.mjs"
    ],
    "src/**/*.{ts,tsx}": [
      "node scripts/code-quality-gate.mjs --staged"
    ]
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@sentry/browser": "^10.70.0",
    "@sentry/node": "^10.70.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "nodemailer": "^9.0.4",
    "pdf-parse": "^2.4.5",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-qr-code": "^2.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "unpdf": "^1.8.0",
    "web-vitals": "^5.3.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jspdf": "^1.3.3",
    "@types/node": "20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode-generator": "^0.0.16",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lighthouse": "^12.8.2",
    "lint-staged": "^15.4.3",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "^4.1.8"
  }
}
