# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL pública de la app (producción) — usada en emails de recuperación y OAuth
NEXT_PUBLIC_SITE_URL=https://drflow.opusorg.com

# Versión mostrada en Ayuda / avisos (opcional; por defecto package.json)
# NEXT_PUBLIC_APP_VERSION=0.2.0

# Solo server-side (opcional: scripts admin, invitaciones)
SUPABASE_SERVICE_ROLE_KEY=

# Labs experimentales en sidebar (pagos mock, telemedicina, recordatorios)
# NEXT_PUBLIC_SHOW_LABS=true

# Dictado por voz en historias clínicas (false desactiva en toda la app)
# NEXT_PUBLIC_VOICE_INPUT_ENABLED=true
