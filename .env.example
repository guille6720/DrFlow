# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL pública de la app (producción) — usada en emails de recuperación y OAuth
NEXT_PUBLIC_SITE_URL=https://drflow.opusorg.com

# Versión mostrada en Ayuda / avisos (opcional; por defecto package.json)
# NEXT_PUBLIC_APP_VERSION=0.2.0

# Solo server-side — NUNCA usar prefijo NEXT_PUBLIC_ ni importar en componentes cliente
SUPABASE_SERVICE_ROLE_KEY=

# Worker cron — protege /api/jobs/process, /api/health?persist=1 y /api/observability/purge
# CRON_SECRET=

# Postgres directo — backups (pg_dump) y migraciones manuales
# Supabase → Project Settings → Database → Connection string (URI)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# URL para npm run check:health (opcional; por defecto NEXT_PUBLIC_SITE_URL o localhost)
# HEALTH_CHECK_URL=http://127.0.0.1:3000

# Email transaccional para invitaciones de equipo (elegí Resend O SMTP)
#
# Opción A — Resend (recomendado): https://resend.com → API Keys
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=DrFlow <onboarding@resend.dev>
#
# Opción B — SMTP (recomendado si ya tenés SMTP en Supabase Auth → mismo remitente @opusorg.com)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@opusorg.com
# SMTP_PASSWORD=...
# EMAIL_FROM=DrFlow <noreply@opusorg.com>

# Sin WhatsApp configurado, los botones abren wa.me con mensaje prellenado para elegir contacto.

# Comercial / ventas (página /planes)
# NEXT_PUBLIC_SALES_EMAIL=ventas@opusorg.com
# NEXT_PUBLIC_SALES_WHATSAPP=5491152591607

# Mercado Pago SaaS billing — Fase 2 (ver docs/MONETIZACION-PLAN.md)
# MP_ACCESS_TOKEN=
# MP_PUBLIC_KEY=
# MP_WEBHOOK_SECRET=

# Telemedicina — Fase 2D (Jitsi embed sin key; Daily.co opcional)
# DAILY_API_KEY=
# DAILY_DOMAIN=your-subdomain.daily.co

# IA clínica opcional (Phase F) — server-only; sin key = solo rule-based
# CLINICAL_AI_LLM_API_KEY=
# CLINICAL_AI_LLM_BASE_URL=https://api.openai.com/v1
# CLINICAL_AI_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=  # alias aceptado por el provider (server-only)

# Dictado por voz en historias clínicas (false desactiva en toda la app)
# NEXT_PUBLIC_VOICE_INPUT_ENABLED=true

# Monitoreo de errores (Fase 1 — opcional; producción)
# SENTRY_DSN=https://...@....ingest.sentry.io/...
# NEXT_PUBLIC_SENTRY_DSN=https://...@....ingest.sentry.io/...
