{
  "project": "DrFlow",
  "repo": "https://github.com/guille6720/DrFlow",
  "production": "https://drflow.opusorg.com",
  "layerLabels": {
    "auth": "Autenticación / guards",
    "business": "Lógica de negocio / servicios",
    "data": "Capa de datos / validación",
    "ui": "Interfaz / componentes"
  },
  "layerOrder": [
    "auth",
    "business",
    "data",
    "ui"
  ],
  "exportCodeCommand": "node scripts/export-qa-module-code.mjs auth",
  "module": {
    "id": "auth",
    "name": "Autenticación",
    "status": "ready",
    "summary": {
      "what": "Login, registro, OAuth, refresh SSR y bootstrap post-login.",
      "inputs": "Credenciales, tokens OAuth, cookies Supabase.",
      "outputs": "Sesión userId/clinicId/role, redirects, errores auth."
    },
    "layers": [
      {
        "layerId": "auth",
        "layerLabel": "Autenticación / guards",
        "what": "Middleware SSR, cookies Supabase, rutas /login|/register|/auth/* y guards de sesión.",
        "inputs": "Request HTTP, cookies auth-token, token_hash OAuth/recovery.",
        "outputs": "Redirect /login, sesión activa, NextResponse con trace-id.",
        "files": [
          "src/middleware.ts",
          "src/core/supabase/middleware.ts",
          "src/core/auth/session.ts",
          "src/core/auth/session.server.ts",
          "src/app/api/auth/login/route.ts",
          "src/app/auth/confirm/route.ts"
        ]
      },
      {
        "layerId": "business",
        "layerLabel": "Lógica de negocio / servicios",
        "what": "Server actions signUp/signIn/signOut, bootstrap post-login y hooks de formularios.",
        "inputs": "FormData (email, password, clinicName), OAuth callback payload.",
        "outputs": "{ data } | { error }, clinicId/userId/role en sesión.",
        "files": [
          "src/lib/actions/auth.ts",
          "src/lib/actions/account.ts",
          "src/lib/auth/post-login-bootstrap.ts",
          "src/core/hooks/use-login-form.ts",
          "src/core/hooks/use-register-clinic-form.ts"
        ]
      },
      {
        "layerId": "data",
        "layerLabel": "Capa de datos / validación",
        "what": "Clientes Supabase (anon/service), tipos Profile/Clinic y validaciones Zod de registro.",
        "inputs": "Queries auth.users, clinics, clinic_members.",
        "outputs": "Filas tipadas, errores PostgREST mapeados.",
        "files": [
          "src/core/supabase/server.ts",
          "src/core/supabase/client.ts",
          "src/core/supabase/env.ts",
          "src/core/validations/schemas.ts",
          "src/types/database.ts"
        ]
      },
      {
        "layerId": "ui",
        "layerLabel": "Interfaz / componentes",
        "what": "Páginas login/registro/restablecer y componentes de formulario + Google OAuth.",
        "inputs": "Eventos usuario, searchParams (?trial=10), errores de action.",
        "outputs": "UI formularios, toasts/errores inline, redirect post-auth.",
        "files": [
          "src/app/(auth)/login/page.tsx",
          "src/app/(auth)/register/page.tsx",
          "src/core/components/auth/login-form-view.tsx",
          "src/core/components/auth/register-clinic-form.tsx",
          "src/core/components/auth/google-login-button.tsx"
        ]
      }
    ],
    "checks": [
      {
        "id": "mod-auth-login",
        "label": "Login válido redirige a dashboard",
        "href": "/login"
      },
      {
        "id": "mod-auth-register",
        "label": "Registro crea clínica + admin",
        "href": "/register"
      },
      {
        "id": "mod-auth-signout",
        "label": "Cerrar sesión limpia la sesión"
      },
      {
        "id": "mod-auth-expired",
        "label": "Sesión expirada redirige a /login"
      }
    ]
  }
}